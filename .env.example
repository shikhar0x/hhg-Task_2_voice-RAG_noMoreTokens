# Local environment configuration template
# Copy this file to .env and replace placeholder values. Never commit your .env file.

# Speech-to-Text (ElevenLabs is preferred when both providers are configured)
# Obtain this key from the ElevenLabs dashboard. Leave blank to use Sarvam only.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Speech-to-Text fallback (Sarvam AI)
# Obtain this key from the Sarvam AI dashboard. Leave blank to use ElevenLabs only.
SARVAM_API_KEY=your_sarvam_api_key_here
# Sarvam speech-to-text API endpoint.
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Grounded response generation (Groq)
# Obtain this key from the Groq console. Leave blank to use the extractive fallback.
GROQ_API_KEY=your_groq_api_key_here
# Groq model identifier used for response generation.
GROQ_MODEL=llama-3.1-8b-instant

# Optional dataset access (Hugging Face)
# Required only for authenticated or gated Hugging Face dataset access.
HF_TOKEN=your_huggingface_token_here

# Local data storage
# Paths are relative to the project root.
CHROMA_PATH=./data/chroma
METRICS_DB_PATH=./data/metrics.db

# Retrieval and application behavior
# Minimum retrieval similarity before the application generates a response (0.0-1.0).
SIMILARITY_THRESHOLD=0.22
# Number of retrieved passages included as context.
DEFAULT_TOP_K=3
# Python log severity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
